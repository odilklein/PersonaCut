# =============================================================================
# PersonaCut — configuração do DocumentRoot (public/)
#
# Este arquivo vale no Apache local (Docker) e em hospedagem compartilhada
# (InfinityFree), desde que o DocumentRoot efetivo seja public/.
# =============================================================================

Options -Indexes

<IfModule mod_headers.c>
    # Não anuncia a versão do PHP.
    Header always unset X-Powered-By

    # Cabeçalhos de segurança.
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Os componentes do painel (Vuexy/helpers/menu/bootstrap bundles) usam
    # webpack com eval e scripts inline, como no sistema de mecânica. Por isso
    # script-src precisa de 'unsafe-inline' 'unsafe-eval'; o restante permanece
    # restrito (somente self + CDNs já usadas pelo projeto).
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://i.ytimg.com https://image.tmdb.org https://upload.wikimedia.org https://thumb.wikimedia.org; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

    # Ative quando o site estiver publicado em HTTPS.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# A aplicação só usa GET, POST e HEAD. Qualquer outro método é recusado.
<LimitExcept GET POST HEAD>
    Require all denied
</LimitExcept>

# Nunca servir arquivos ocultos (.env, .git, .htaccess...).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
